# EarthSynoptic repository text normalization
#
# Canonical repository line endings:
# - Text files: LF
# - Windows batch/command files: CRLF
# - Binary files: no text conversion

* text=auto eol=lf

# Windows command scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
