# EarthSynoptic EditorConfig baseline
#
# Keep this file conservative and toolchain-neutral.
# Language-, framework-, and tool-specific formatting rules should be added
# only when the corresponding toolchain is adopted.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Match the repository's Git EOL policy for Windows command scripts.
[*.bat]
end_of_line = crlf

[*.cmd]
end_of_line = crlf
